{
  "variables": {
    "farshell.server": "127.0.0.1:7777"
  },
  "tools": {
    "farshell": {
      "repo": "owner/farshell",
      "asset": "farshell-win-x64.zip",
      "enabled": true,
      "commands": {
        "farshell": {
          "executable": "farshell.exe",
          "environment": {
            "FARSHELL_SERVER": {
              "variable": "farshell.server"
            },
            "OPENAI_API_KEY": {
              "secret": "openai.api-key"
            }
          }
        }
      },
      "daemons": {
        "farshell": {
          "executable": "farshelld.exe",
          "autostart": true,
          "restartOnUpdate": true,
          "environment": {
            "LOG_LEVEL": "info",
            "OPENAI_API_KEY": {
              "secret": "openai.api-key"
            }
          }
        }
      }
    },
    "devproxy": {
      "repo": "owner/devproxy",
      "asset": "devproxy-win-x64.zip",
      "enabled": true,
      "commands": {
        "devproxy": {
          "executable": "app/devproxy.exe"
        }
      }
    }
  }
}
